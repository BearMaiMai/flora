/* components/empty-state/empty-state.wxss */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 160rpx 48rpx;
}

.empty-icon-wrap {
  margin-bottom: 32rpx;
  height: 88rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.empty-icon-emoji {
  font-size: 80rpx;
}

.empty-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: var(--font-sm);
  color: var(--text-hint);
  margin-bottom: 48rpx;
  line-height: 1.6;
}

.empty-btn {
  background-color: var(--color-primary);
  color: var(--text-white);
  padding: 20rpx 64rpx;
  border-radius: var(--border-radius-round);
  box-shadow: var(--shadow-btn);
}

.empty-btn-text {
  font-size: var(--font-md);
  font-weight: 500;
}
