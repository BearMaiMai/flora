<!--components/empty-state/empty-state.wxml-->
<view class="empty-state">
  <view class="empty-icon-wrap {{iconName || icon ? 'anim-float' : ''}}">
    <icon wx:if="{{iconName}}" name="{{iconName}}" size="xl" color="{{iconColor || '#E0E0E0'}}" />
    <text wx:elif="{{icon}}" class="empty-icon-emoji">{{icon}}</text>
  </view>
  <text wx:if="{{title}}" class="empty-title">{{title}}</text>
  <text class="empty-desc">{{desc}}</text>
  <view class="empty-btn" wx:if="{{btnText}}" bindtap="onBtnTap" hover-class="hover-btn" hover-stay-time="100">
    <text class="empty-btn-text">{{btnText}}</text>
  </view>
</view>
