{
  "pages": [
    "pages/index/index",
    "pages/encyclopedia/index",
    "pages/encyclopedia/detail",
    "pages/garden/index",
    "pages/garden/plant-detail",
    "pages/garden/diary-edit",
    "pages/profile/index",
    "pages/profile/favorites/index",
    "pages/profile/settings/index",
    "pages/profile/agreement/index",
    "pages/profile/privacy/index"
  ],
  "subPackages": [
    {
      "root": "pages/guide",
      "pages": ["index", "detail"]
    },
    {
      "root": "pages/reminder",
      "pages": ["index"]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["pages/guide"]
    },
    "pages/profile/index": {
      "network": "all",
      "packages": ["pages/reminder"]
    }
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#4CAF50",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "images/tabbar/home.png",
        "selectedIconPath": "images/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/encyclopedia/index",
        "text": "百科",
        "iconPath": "images/tabbar/encyclopedia.png",
        "selectedIconPath": "images/tabbar/encyclopedia-active.png"
      },
      {
        "pagePath": "pages/garden/index",
        "text": "花园",
        "iconPath": "images/tabbar/garden.png",
        "selectedIconPath": "images/tabbar/garden-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "images/tabbar/profile.png",
        "selectedIconPath": "images/tabbar/profile-active.png"
      }
    ]
  },
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#F8FBF5",
    "navigationBarTitleText": "养花呀",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#F8FBF5",
    "animationDuration": 300
  },
  "usingComponents": {
    "icon": "/components/icon/icon",
    "empty-state": "/components/empty-state/empty-state"
  },
  "sitemapLocation": "sitemap.json",
  "style": "v2"
}
