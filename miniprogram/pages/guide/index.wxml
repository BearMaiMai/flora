<!--pages/guide/index.wxml - 种植指南-->
<scroll-view class="guide-scroll" scroll-y enhanced show-scrollbar="{{false}}" bounces="{{true}}">
<view class="guide-page">
  <!-- 页面头部 -->
  <view class="guide-header">
    <view class="guide-title-row">
      <icon src="/images/icons/flower/a-008-dandelion.svg" size="md" />
      <text class="guide-page-title font-brand">种植指南</text>
    </view>
  </view>

  <!-- 精选指南 - 大图卡片 -->
  <view class="featured-card anim-fade-in-up" bindtap="goToDetail" data-id="{{featuredGuide._id}}" hover-class="hover-card" hover-stay-time="100">
    <view class="featured-image-wrap">
      <view class="featured-image-bg"></view>
      <view class="featured-overlay">
        <view class="featured-reading-badge">{{featuredGuide.readTime || '5分钟'}}</view>
        <text class="featured-title">{{featuredGuide.title}}</text>
        <text class="featured-desc">{{featuredGuide.summary}}</text>
      </view>
    </view>
  </view>

  <!-- 分类图标 -->
  <view class="category-section">
    <scroll-view scroll-x class="category-scroll" enable-flex>
      <view class="category-circle-item {{activeCategory === item.key ? 'category-active' : ''}}" wx:for="{{categoryList}}" wx:key="key" 
            bindtap="onSelectCategory" data-category="{{item.key}}"
            hover-class="hover-icon" hover-stay-time="100">
        <view class="category-circle" style="background-color: {{item.bgColor}};">
          <text class="category-emoji">{{item.icon}}</text>
        </view>
        <text class="category-label">{{item.label}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 指南文章列表 -->
  <view class="article-section">
    <text class="article-section-title">{{activeCategoryLabel || '全部指南'}}</text>
    <view class="article-list">
      <block wx:for="{{filteredGuideList}}" wx:key="_id">
      <view class="article-card anim-fade-in-up anim-delay-{{index < 8 ? index + 1 : 8}}" bindtap="goToDetail" data-id="{{item._id}}" hover-class="hover-card" hover-stay-time="100">
        <view class="article-thumb">
          <icon emoji="{{item.icon}}" size="lg" />
        </view>
        <view class="article-info">
          <text class="article-title">{{item.title}}</text>
          <text class="article-summary">{{item.summary}}</text>
          <view class="article-meta">
            <text class="article-difficulty" wx:if="{{item.difficulty}}">{{item.difficulty}}</text>
            <text class="article-read-time">{{item.readTime || '3分钟阅读'}}</text>
          </view>
        </view>
        <view class="article-arrow">
          <icon name="chevronRight" size="sm" color="var(--text-hint)" />
        </view>
      </view>
      </block>
    </view>
  </view>

  <!-- 空状态 -->
  <empty-state wx:if="{{!loading && !filteredGuideList.length}}" icon="📖" desc="{{activeCategory ? '该分类暂无指南' : '暂无指南文章'}}" />
</view>
<view class="bottom-spacer"></view>
</scroll-view>
