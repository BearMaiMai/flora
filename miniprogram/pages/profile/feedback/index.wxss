/* pages/profile/feedback/index.wxss - 意见反馈 */
@import '../../../styles/common.wxss';

.page-layout {
  min-height: 100vh;
  background-color: var(--bg-page);
}

.feedback-page {
  padding: 24rpx;
}

/* 邮箱联系卡片 */
.email-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, #e8f5e9, #f1f8e9);
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
}

.email-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.email-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.email-addr {
  font-size: 30rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.email-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-hint);
  line-height: 1.6;
  padding: 0 8rpx;
}

/* 表单区域 */
.form-section {
  margin-top: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 28rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.required {
  color: #E53935;
}

.form-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 20rpx;
  border: 2rpx solid var(--border-light);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  line-height: 1.6;
  background: var(--bg-page);
}

.form-textarea:focus {
  border-color: var(--color-primary);
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid var(--border-light);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  background: var(--bg-page);
}

.form-input:focus {
  border-color: var(--color-primary);
}

.placeholder {
  color: var(--text-hint);
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, var(--color-primary), #66BB6A);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  margin-top: 16rpx;
}

.submit-btn.disabled {
  opacity: 0.6;
}
