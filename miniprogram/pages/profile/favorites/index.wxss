/* pages/profile/favorites/index.wxss - 我的收藏 */
@import '/styles/animation.wxss';

.favorites-page {
  padding: 24rpx 24rpx 48rpx;
}

/* 骨架屏 */
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.skeleton-card {
  display: flex;
  align-items: center;
  background-color: var(--bg-card);
  border-radius: var(--border-radius-lg);
  padding: 24rpx;
}

.skeleton-info {
  flex: 1;
  margin-left: 20rpx;
}

/* 收藏列表 */
.favorites-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.fav-card {
  display: flex;
  align-items: center;
  background-color: var(--bg-card);
  border-radius: var(--border-radius-lg);
  padding: 20rpx;
  box-shadow: var(--shadow-sm);
  transition: transform var(--transition-fast), box-shadow var(--transition-fast);
}

.fav-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--border-radius-md);
  overflow: hidden;
  flex-shrink: 0;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  display: flex;
  justify-content: center;
  align-items: center;
}

.thumb-emoji {
  font-size: 56rpx;
}

.fav-info {
  flex: 1;
  padding: 0 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.fav-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.fav-name {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
}

.fav-tag {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--border-radius-round);
  font-weight: 500;
}

.fav-desc {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fav-meta {
  display: flex;
  align-items: center;
}

.meta-label {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-right: 4rpx;
}

.star {
  font-size: 22rpx;
  margin-right: 2rpx;
}

.star.filled {
  color: var(--color-primary);
}

.star.empty {
  color: var(--border-color);
}

/* 取消收藏按钮 */
.unfav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-left: 8rpx;
}

/* 底部安全留白 */
.bottom-spacer {
  height: 32rpx;
}
