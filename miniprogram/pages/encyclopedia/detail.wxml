<!--pages/encyclopedia/detail.wxml - 花卉详情页-->
<!-- 骨架屏 -->
<skeleton type="detail" loading="{{!flower}}" />

<view class="detail-page" wx:if="{{flower}}">
  <!-- Hero 头图区域 -->
  <view class="hero-section">
    <view class="hero-image-wrap">
      <image wx:if="{{flower.coverImage && !imgError}}" class="hero-image" src="{{flower.coverImage}}" mode="aspectFill" binderror="onHeroImageError" />
      <view wx:else class="hero-placeholder">
        <icon name="rose" size="xl" />
      </view>
    </view>
    <view class="hero-gradient"></view>
    <!-- 浮动返回按钮 -->
    <view class="hero-nav" style="padding-top: {{statusBarHeight + 10}}px;">
      <view class="nav-btn" bindtap="onGoBack">
        <icon name="chevronLeft" size="md" color="var(--text-primary)" />
      </view>
    </view>
  </view>

  <!-- 基本信息区域 -->
  <view class="info-section">
    <text class="flower-name-lg">{{flower.name}}</text>
    <text class="flower-alias" wx:if="{{flower.alias}}">{{flower.alias}}</text>
    <view class="info-tags">
      <text class="tag tag-green">{{flower.category}}</text>
      <text class="tag tag-difficulty">难度 {{flower.difficulty === 1 ? '⭐' : flower.difficulty === 2 ? '⭐⭐' : '⭐⭐⭐'}}</text>
    </view>
  </view>

  <!-- 花语区域 -->
  <view class="flower-language-section" wx:if="{{flower.flowerLanguage}}">
    <view class="language-divider">
      <view class="divider-line"></view>
      <text class="divider-icon">🌸</text>
      <view class="divider-line"></view>
    </view>
    <text class="flower-language-text">"{{flower.flowerLanguage}}"</text>
  </view>

  <!-- 养护指南 - 左右排列卡片 -->
  <view class="care-section" wx:if="{{flower.careGuide}}">
    <view class="section-title-row">
      <icon src="/images/icons/flower/a-029-arugula.svg" size="sm" />
      <text class="section-title">养护指南</text>
    </view>
    <view class="care-grid {{careExpanded ? 'care-expanded' : ''}}">
      <view class="care-card card-water">
        <icon name="water" size="lg" bg="water" />
        <view class="care-card-text">
          <text class="care-card-label">浇水</text>
          <text class="care-card-value {{careExpanded ? '' : 'text-clamp-1'}}">{{flower.careGuide.water}}</text>
        </view>
      </view>
      <view class="care-card card-sun">
        <icon name="sun" size="lg" bg="sun" />
        <view class="care-card-text">
          <text class="care-card-label">光照</text>
          <text class="care-card-value {{careExpanded ? '' : 'text-clamp-1'}}">{{flower.careGuide.light}}</text>
        </view>
      </view>
      <view class="care-card card-soil">
        <icon name="soil" size="lg" bg="soil" />
        <view class="care-card-text">
          <text class="care-card-label">土壤</text>
          <text class="care-card-value {{careExpanded ? '' : 'text-clamp-1'}}">{{flower.careGuide.soil}}</text>
        </view>
      </view>
      <view class="care-card card-temp">
        <icon name="temp" size="lg" bg="temp" />
        <view class="care-card-text">
          <text class="care-card-label">温度</text>
          <text class="care-card-value {{careExpanded ? '' : 'text-clamp-1'}}">{{flower.careGuide.temperature}}</text>
        </view>
      </view>
      <view class="care-card card-fertilizer">
        <icon name="fertilizer" size="lg" bg="fertilizer" />
        <view class="care-card-text">
          <text class="care-card-label">施肥</text>
          <text class="care-card-value {{careExpanded ? '' : 'text-clamp-1'}}">{{flower.careGuide.fertilizer}}</text>
        </view>
      </view>
      <view class="care-card card-humidity">
        <icon name="humidity" size="lg" bg="humidity" />
        <view class="care-card-text">
          <text class="care-card-label">湿度</text>
          <text class="care-card-value {{careExpanded ? '' : 'text-clamp-1'}}">{{flower.careGuide.humidity}}</text>
        </view>
      </view>
    </view>
    <view class="care-expand-btn" bindtap="toggleCareExpand" hover-class="hover-btn" hover-stay-time="100">
      <text>{{careExpanded ? '收起' : '展开详情'}}</text>
      <icon name="{{careExpanded ? 'chevronUp' : 'chevronDown'}}" size="xs" tint="primary" />
    </view>
  </view>

  <!-- 标签 -->
  <view class="tags-section" wx:if="{{flower.tags.length}}">
    <view class="tags-row">
      <text class="flower-tag" wx:for="{{flower.tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- 小贴士 -->
  <view class="tips-section anim-fade-in-up anim-delay-3" wx:if="{{flower.tips.length}}">
    <text class="section-title">💡 养护小贴士</text>
    <view class="tips-list">
      <view class="tip-item" wx:for="{{flower.tips}}" wx:key="*this">
        <view class="tip-number">{{index + 1}}</view>
        <text class="tip-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 专家问答 -->
  <view class="expert-section anim-fade-in-up anim-delay-4" wx:if="{{flower.expertAnswer.length}}">
    <text class="section-title">🧑‍🌾 专家问答</text>
    <view class="expert-list">
      <view class="expert-item" wx:for="{{flower.expertAnswer}}" wx:key="*this">
        <view class="expert-q-icon">Q</view>
        <text class="expert-text">Q: {{item.question}}</text>
        <view class="expert-a-icon">A</view>
        <text class="expert-text">A: {{item.answer}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar safe-bottom">
    <view class="action-fav {{isFavorite ? 'fav-active fav-heartbeat' : ''}}" bindtap="onToggleFavorite">
      <icon name="{{isFavorite ? 'heart' : 'heartEmpty'}}" size="md" />
    </view>
    <view class="action-add-btn" bindtap="onAddToGarden">
      <icon name="add" size="sm" tint="white" />
      <text class="add-btn-text">添加到花园</text>
    </view>
  </view>
</view>

<!-- 加载状态 -->
<view class="loading-state" wx:else>
  <icon src="/images/icons/flower/a-015-lotusflower.svg" size="xl" />
  <text class="loading-text">加载中...</text>
</view>
