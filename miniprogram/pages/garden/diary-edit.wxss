/* pages/garden/diary-edit.wxss */
.container { padding: 24rpx 24rpx 48rpx; }
.diary-input {
  width: 100%;
  min-height: 200rpx;
  max-height: 320rpx;
  padding: 24rpx;
  background-color: var(--bg-card);
  border-radius: var(--border-radius-md);
  font-size: var(--font-md);
  line-height: 1.8;
  box-sizing: border-box;
}

.diary-section-label {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin: 32rpx 0 16rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  border-radius: 100rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border-color);
  font-size: var(--font-sm);
  color: var(--text-primary);
  transition: all 0.2s;
}

.chip-active {
  background: var(--bg-green-light);
  border-color: var(--color-primary);
  color: var(--color-primary-dark);
}

.hover-chip {
  opacity: 0.7;
}

.chip-icon {
  font-size: 28rpx;
}

.image-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.image-item {
  width: 200rpx; height: 200rpx;
  border-radius: var(--border-radius-sm);
  overflow: hidden;
  position: relative;
}
.image-item image { width: 100%; height: 100%; }
.remove-btn {
  position: absolute; top: 4rpx; right: 4rpx;
  width: 40rpx; height: 40rpx;
  background: var(--bg-mask); color: var(--text-white);
  border-radius: 50%;
  display: flex; justify-content: center; align-items: center;
  font-size: var(--font-md);
}
.image-add {
  width: 200rpx; height: 200rpx;
  border: 2rpx dashed var(--border-color);
  border-radius: var(--border-radius-sm);
  display: flex; justify-content: center; align-items: center;
}
.add-icon { font-size: 60rpx; color: var(--text-hint); }
.submit-btn { width: 100%; margin-top: 48rpx; }
.btn-danger {
  width: 100%;
  background: transparent;
  color: var(--color-danger);
  border: 2rpx solid var(--color-danger);
  border-radius: var(--border-radius-md);
  padding: 24rpx;
  font-size: var(--font-md);
}
.btn-danger:active { background: rgba(229, 57, 53, 0.06); }
