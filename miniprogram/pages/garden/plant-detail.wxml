<!--pages/garden/plant-detail.wxml - 植物详情页-->
<view class="plant-detail-page" wx:if="{{plant}}">
  <!-- 植物头像区域 -->
  <view class="plant-profile-section">
    <view class="plant-avatar-glow">
      <view class="glow-ring"></view>
      <view class="plant-avatar-large">
        <icon name="sunflower" size="xl" />
      </view>
    </view>
    <text class="plant-nickname" bindtap="onEditNickname">{{plant.nickname}}</text>
    <text class="plant-species">{{plant.flowerName}}</text>
    
    <!-- 信息标签 -->
    <view class="plant-info-pills">
      <view class="info-pill" bindtap="onEditLocation">
        <icon src="/images/icons/common/place.svg" size="xs" />
        <text class="pill-text">{{plant.location || '点击设置位置'}}</text>
      </view>
      <picker mode="date" value="{{plant.addDate || todayStr}}" bindchange="onPurchaseDateChange" class="info-pill">
        <view class="info-pill-inner">
          <icon src="/images/icons/common/date.svg" size="xs" />
          <text class="pill-text">养了{{plant.days}}天</text>
        </view>
      </picker>
      <view class="info-pill pill-status-{{plant.status}}" bindtap="onEditStatus">
        <icon name="leaf" size="xs" />
        <text class="pill-text">{{statusLabel}}</text>
      </view>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-row anim-fade-in-up anim-delay-1">
    <view class="stat-mini-card">
      <text class="stat-mini-num font-number">{{stats.diaryCount}}</text>
      <text class="stat-mini-label">日记条数</text>
    </view>
    <view class="stat-mini-card">
      <text class="stat-mini-text">{{stats.lastWatered}}</text>
      <text class="stat-mini-label">上次浇水</text>
    </view>
    <view class="stat-mini-card">
      <text class="stat-mini-text">{{stats.lastFertilized}}</text>
      <text class="stat-mini-label">上次施肥</text>
    </view>
  </view>

  <!-- 成长日记 - 时间线设计 -->
  <view class="diary-section">
    <view class="diary-header flex-between">
      <text class="diary-title">📔 成长日记</text>
      <view class="diary-add-btn" bindtap="goToAddDiary">
        <icon name="edit" size="sm" color="var(--color-primary)" />
        <text class="diary-add-text">记录</text>
      </view>
    </view>

    <view class="diary-timeline" wx:if="{{diaryList.length}}">
      <view class="timeline-entry" wx:for="{{diaryList}}" wx:key="_id">
        <view class="entry-timeline-left">
          <view class="entry-dot"></view>
          <view class="entry-line" wx:if="{{index < diaryList.length - 1}}"></view>
        </view>
        <view class="entry-card">
          <view class="entry-date-bubble">{{item.date}}</view>
          <text class="entry-content">{{item.content}}</text>
          <view class="entry-images" wx:if="{{item.images && item.images.length}}">
            <image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" class="entry-img" src="{{img}}" mode="aspectFill" />
          </view>
        </view>
      </view>
    </view>

    <view class="diary-empty" wx:else>
      <icon name="tulip" size="xl" />
      <text class="diary-empty-text">还没有日记，记录一下吧</text>
    </view>
  </view>

  <!-- 浮动添加按钮 -->
  <view class="fab" bindtap="goToAddDiary">
    <icon name="add" size="lg" color="var(--text-white)" />
  </view>

  <!-- 移除植物入口 -->
  <view class="danger-action-section">
    <view class="danger-btn" bindtap="onRemovePlant" hover-class="hover-btn" hover-stay-time="100">
      <icon name="delete" size="sm" color="var(--color-danger)" />
      <text class="danger-btn-text">移除这株植物</text>
    </view>
  </view>
</view>
